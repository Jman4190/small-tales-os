# Copy to .env.local. Use your own development accounts and test payment keys.
# NEXT_PUBLIC_* values are public. Blank values leave services unconfigured.

# Supabase (secret key must remain server-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy aliases: NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Generate: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Shared between web and workers; signs guest access and internal requests.
INTERNAL_API_SECRET=
AI_DAILY_CREATE_LIMIT=100
AI_DAILY_VERIFY_LIMIT=200

# Local Inngest server handles local delivery. Deployment requires both keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

LEONARDO_API_KEY=
FAL_KEY=

# Create all Stripe resources in the same test account/environment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_TAX_RATE_ID=
STRIPE_SHIPPING_RATE_ID=
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=

# Verify your own domain and update approved senders in lib/email.ts first.
EMAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
ADMIN_NOTIFICATION_EMAIL=
# Explicit fallback only: select EMAIL_PROVIDER=resend to use this.
RESEND_API_KEY=

# pdf-api.io template must match generatePdfs.ts request fields.
PDF_API_KEY=
PDF_TEMPLATE_ID=
# Gelato calls can place paid print orders.
GELATO_API_KEY=
GELATO_WEBHOOK_SECRET_NONINNGEST=

# Optional SMS: shared sender uses API key SID/secret and account SID.
# Legacy direct SMS route also uses TWILIO_AUTH_TOKEN.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Slack alerts and command verification.
SLACK_BOT_TOKEN=
SIGNING_SECRET=
ORDER_TRACKING_SLACK_CHANNEL_ID=
VERIFY_IMAGE_SLACK_WEBHOOK_URL=
CREATE_BOOK_SLACK_WEBHOOK_URL=
PREVIEW_IMAGE_SLACK_WEBHOOK_URL=
PDF_SLACK_WEBHOOK_URL=
BOOK_DELIVERY_SLACK_WEBHOOK_URL=
INNGEST_FAILURE_SLACK_WEBHOOK_URL=
LEONARDO_IMAGES_SLACK_WEBHOOK_URL=

# Optional logging: browser token must be a separate browser-safe source token.
LOGTAIL_TOKEN=
LOGTAIL_ENDPOINT=
NEXT_PUBLIC_LOGTAIL_BROWSER_TOKEN=
NEXT_PUBLIC_LOGTAIL_ENDPOINT=

# Optional analytics and advertising. Leave empty for development.
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=
FACEBOOK_PIXEL_ID=
FACEBOOK_CONVERSION_API_ACCESS_TOKEN=
FACEBOOK_TEST_EVENT_CODE=
# VERCEL_URL is supplied automatically by Vercel.
